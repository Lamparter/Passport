# Create an app at https://auth.hackclub.com/developer/apps
# Redirect URI: https://passport.lamparter.dev/auth/callback (and http://localhost:5173/auth/callback for dev)
HCA_CLIENT_ID=
HCA_CLIENT_SECRET=

# Long random string (32+ chars). Encrypts the session cookie and staff-scan QR tokens.
SESSION_SECRET=

# Optional. Community apps get the default scopes below. If Hack Club HQ promotes the
# app to hq_official, add "basic_info address" to show real date of birth and country.
# HCA_SCOPES="openid profile email name slack_id verification_status"

# Optional. Public origin, if it can't be inferred from the request.
# PUBLIC_ORIGIN=https://passport.lamparter.dev
